@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Newborn | เข้าสู่ระบบ</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Login/Login.css" />
</head>
<body class="nb-body">
    <div class="container-fluid p-0">
        <div class="row g-0 nb-row">
            <aside class="col-lg-6 nb-brand">
                <div class="nb-copy">
                    <div class="nb-mark">Newborn</div>
                    <p>ระบบติดตามข้อมูลทารกแรกเกิด</p>
                </div>
                <div class="nb-art" aria-hidden="true">
                    <svg class="nb-baby" viewBox="0 0 300 320">
                        <g class="nb-react"><g class="nb-float">
                            <g class="nb-head">
                                <circle cx="60" cy="168" r="15" fill="#FFF4CC" /><circle cx="240" cy="168" r="15" fill="#FFF4CC" />
                                <circle cx="150" cy="160" r="92" fill="#FFF4CC" />
                                <path class="nb-tuft" d="M148 70C132 44 164 30 158 52" fill="none" stroke="#FFC400" stroke-width="7" stroke-linecap="round" />
                                <ellipse class="nb-cheek" cx="98" cy="192" rx="16" ry="10" fill="#FFC400" opacity=".6" />
                                <ellipse class="nb-cheek" cx="202" cy="192" rx="16" ry="10" fill="#FFC400" opacity=".6" />
                                <path class="nb-eyes" d="M104 158q14 14 28 0M168 158q14 14 28 0" fill="none" stroke="#111" stroke-width="6" stroke-linecap="round" />
                                <path class="nb-mouth" d="M138 190q12 12 24 0" fill="none" stroke="#111" stroke-width="6" stroke-linecap="round" />
                            </g>
                            <g class="nb-hand">
                                <ellipse cx="118" cy="160" rx="32" ry="24" fill="#FFF4CC" stroke="#111" stroke-width="4" />
                                <path d="M102 152v12M118 148v16M134 152v12" fill="none" stroke="#E3D39B" stroke-width="3" stroke-linecap="round" />
                            </g>
                            <g class="nb-hand">
                                <ellipse cx="182" cy="160" rx="32" ry="24" fill="#FFF4CC" stroke="#111" stroke-width="4" />
                                <path d="M166 152v12M182 148v16M198 152v12" fill="none" stroke="#E3D39B" stroke-width="3" stroke-linecap="round" />
                            </g>
                        </g></g>
                    </svg>
                </div>
            </aside>

            <main class="col-lg-6 nb-pane">
                <form id="loginForm" novalidate class="nb-form">
                    @Html.AntiForgeryToken()
                    <h2>เข้าสู่ระบบ</h2>
                    <p class="nb-sub">กรอกชื่อผู้ใช้และรหัสผ่านของคุณ</p>

                    <div class="mb-3">
                        <label for="Username" class="form-label">ชื่อผู้ใช้</label>
                        <input id="Username" name="Username" type="text" class="form-control" placeholder="Username" autocomplete="username" autofocus required minlength="3" maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label for="Password" class="form-label">รหัสผ่าน</label>
                        <div class="nb-input">
                            <input id="Password" name="Password" type="password" class="form-control nb-pw" placeholder="Password" autocomplete="current-password" required />
                            <button type="button" class="nb-eye" id="togglePw" aria-label="แสดงรหัสผ่าน">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="nb-btn" id="loginBtn">เข้าสู่ระบบ</button>
                    <p class="nb-foot">© 2026 ชื่อองค์กรของคุณ · เวอร์ชัน 1.0.0</p>
                </form>
            </main>
        </div>
    </div>

    <script>
        const returnUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["ReturnUrl"] ?? ""));
        const createLoginUrl = '@Url.Action("Create", "Login")' + (returnUrl ? `?returnUrl=${encodeURIComponent(returnUrl)}` : '');
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/Common/AlertService.js" asp-append-version="true"></script>
    <script src="~/js/Login/Login.js" asp-append-version="true"></script>
</body>
</html>
