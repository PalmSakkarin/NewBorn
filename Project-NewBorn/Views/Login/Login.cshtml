@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Newborn | เข้าสู่ระบบ</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Login/Login.css" />
</head>
<body class="nb-body">
    <div class="container d-flex justify-content-center">
        <div class="nb-shell">
            <div class="nb-card">
                <div class="nb-head">
                    <h1>Newborn</h1>
                    <p>ระบบติดตามข้อมูลทารกแรกเกิด</p>
                    <svg class="nb-ecg" viewBox="0 0 400 46" preserveAspectRatio="none" aria-hidden="true"><path d="M0 26 H120 L134 26 L146 6 L160 40 L172 26 H250 L260 26 L270 14 L280 26 H400" /></svg>
                    <svg class="nb-wave" viewBox="0 0 400 34" preserveAspectRatio="none" aria-hidden="true"><path d="M0 34 V18 C90 -2 200 -2 290 14 C335 22 370 24 400 20 V34 Z" /></svg>
                </div>

                <form id="loginForm" novalidate class="nb-form">
                    <div class="mb-3">
                        <label for="Username" class="form-label">ชื่อผู้ใช้</label>
                        <div class="nb-input">
                            <svg class="nb-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.2 3.6-7 8-7s8 2.8 8 7" /></svg>
                            <input id="Username" name="Username" type="text" class="form-control" placeholder="Username" autocomplete="username" autofocus required minlength="3" maxlength="100" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Password" class="form-label">รหัสผ่าน</label>
                        <div class="nb-input">
                            <svg class="nb-ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2.5" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
                            <input id="Password" name="Password" type="password" class="form-control nb-pw" placeholder="Password" autocomplete="current-password" required minlength="6" maxlength="200" />
                            <button type="button" class="nb-eye" id="togglePw" aria-label="แสดงรหัสผ่าน">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                    </div>

                    <div class="nb-err" id="loginError" role="alert"></div>
                    <div class="nb-success" id="loginMessage" role="status"></div>
                    <button type="submit" class="nb-btn" id="loginBtn">เข้าสู่ระบบ</button>
                    <p class="nb-foot">© 2026 ชื่อองค์กรของคุณ<br />เวอร์ชัน 1.0.0</p>
                </form>
            </div>
        </div>
    </div>

    <script>
        const createLoginUrl = '@Url.Action("Create", "Login")';
    </script>
    <script src="~/js/Login/Login.js"></script>
</body>
</html>
